{
  "name": "mintpilot",
  "version": "2.3.2",
  "private": true,
  "description": "Telegram bot that schedules and automatically signs NFT mints from encrypted custodial wallets on Ethereum, Base, Ink, Robinhood Chain, Arbitrum One, OP Mainnet, Zora, Shape, Unichain and Soneium",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js",
    "bot": "node src/index.js --roles=bot",
    "web": "node src/index.js --roles=web",
    "worker": "node src/index.js --roles=worker",
    "check:rpc": "node scripts/check-rpc.js",
    "compile": "hardhat compile",
    "build:wallet-import": "esbuild src/web/public/wallet-import-entry.js --bundle --format=iife --outfile=src/web/public/assets/wallet-import.js",
    "test": "npm run lint && npm run test:unit && npm run test:contracts",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:contracts": "hardhat test",
    "lint": "eslint .",
    "release": "node scripts/release.js",
    "release:check": "node scripts/release.js --check"
  },
  "dependencies": {
    "ethers": "^6.14.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "hardhat": "^2.22.18"
  }
}
