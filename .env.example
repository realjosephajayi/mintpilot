# MintPilot v2.3.0 — mainnets only. Copy to .env (never commit it; `npm run release` refuses to package it).

# ───────── Telegram ─────────
# From @BotFather. Secret.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram IDs allowed to use /grant and /stats
ADMIN_TELEGRAM_IDS=

# ───────── Web (wallet import portal + dashboard) ─────────
# MUST be a public HTTPS URL in production (Telegram buttons require https).
PUBLIC_URL=http://localhost:3000
PORT=3000
# Number of reverse proxies in front of the web server (Railway: 1). Only the address added by the
# last trusted proxy is used for rate limiting; earlier X-Forwarded-For entries are client-supplied.
# (Legacy TRUST_PROXY=true is read as 1.)
TRUST_PROXY_HOPS=0
# Alternative to hops: a single-value client-IP header set by an edge you control, trusted ONLY when the
# origin is reachable through that edge alone. Behind a Cloudflare tunnel use cf-connecting-ip, otherwise
# every web user shares the tunnel's loopback address (one rate-limit bucket).
# One of: cf-connecting-ip, true-client-ip, x-real-ip, fly-client-ip
CLIENT_IP_HEADER=
# Bearer token for GET /metrics (Prometheus). Empty = metrics endpoint disabled. Secret.
METRICS_TOKEN=

# ───────── Storage ─────────
DATABASE_PATH=data/bot.sqlite
ELIGIBILITY_FILE=data/eligible-addresses.json

# ───────── Eligibility providers (operator-only) ─────────
# Merkle proofs, mint signatures and SeaDrop server signatures come ONLY from providers listed here.
# Users reference a provider by id in the bot; they can never supply URLs or file paths.
# kind: merkle | signature | seadrop-signed. HTTPS required (HTTP only to localhost outside production).
# Redirects are refused, responses are capped at 64 KB, and a provider should answer 429/5xx for
# "try again later" and 4xx for "this wallet is not eligible". Keep secrets in `headers`.
# Example:
# ELIGIBILITY_PROVIDERS_JSON={"my-proofs":{"kind":"merkle","url":"https://issuer.example/proof","method":"GET","chain":"base","contract":"0x..."},"my-seadrop":{"kind":"seadrop-signed","url":"https://issuer.example/sig","method":"POST","headers":{"authorization":"Bearer ..."}}}
ELIGIBILITY_PROVIDERS_JSON={}
# Legacy name; entries are read as kind "seadrop-signed". Prefer ELIGIBILITY_PROVIDERS_JSON.
SEADROP_SIGNATURE_PROVIDERS_JSON={}
# Optional OpenSea REST API key for ERC-721 SeaDrop V1 drops. Server-side only.
# All users share this key's write quota; get a full key / rate-limit increase before batch launches.
OPENSEA_API_KEY=

# ───────── Chains (mainnets only) ─────────
# Public RPCs are rate limited; use a provider (Alchemy, QuickNode, Chainstack...) for every chain you
# enable. URLs stay on the server. Signed mints go to EVERY configured endpoint at once: for launches use a
# low-latency endpoint near the sequencer plus fallbacks, e.g. RPC_FALLBACK_URLS_JSON={"robinhood":["https://backup.example"]}
RPC_FALLBACK_URLS_JSON={}
# Per endpoint. Raise to your provider plan's limit: every user's reads share it.
RPC_RATE_LIMIT_PER_SECOND=10
RPC_RATE_LIMIT_BURST=5
RPC_FAILURE_COOLDOWN_MS=5000
# Hard timeout per RPC request; a slow endpoint fails over instead of hanging (ethers' default is 5 min).
RPC_TIMEOUT_MS=8000
# <KEY>_RPC_URL for each chain in src/chains.js. Empty = the public default shown.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
INK_RPC_URL=https://rpc-gel.inkonchain.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
ZORA_RPC_URL=https://rpc.zora.energy
SHAPE_RPC_URL=https://mainnet.shape.network
UNICHAIN_RPC_URL=https://mainnet.unichain.org
SONEIUM_RPC_URL=https://rpc.soneium.org
# Optional: last-resort verified-ABI source (Blockscout and Sourcify are used first and need no key).
# Etherscan's free tier covers Ethereum and Arbitrum here; Base and OP need a paid plan.
ETHERSCAN_API_KEY=
# Chain used to verify smart-contract-wallet signatures (ERC-1271) on the import page
ERC1271_CHAIN=base

# ───────── Plans ─────────
FREE_ACTIVE_SCHEDULES=3
PREMIUM_ACTIVE_SCHEDULES=30
FREE_WALLETS=1
PREMIUM_WALLETS=5
FREE_PENDING_TXS=5
PREMIUM_PENDING_TXS=50
PREMIUM_PRICE_STARS=250
PREMIUM_DAYS=30

# ───────── Referrals ─────────
# Rewarded once, when the referred user's first scheduled mint confirms on-chain.
REFERRAL_REFERRER_DAYS=3
REFERRAL_REFEREE_DAYS=1
REFERRAL_MAX_REWARDS=20

# ───────── Safety limits ─────────
MAX_MINT_VALUE_ETH=1
MAX_MINT_QUANTITY=10

# ───────── Launch timing ─────────
# After the stated opening time, an unexplained revert still counts as "not open yet" for this long.
LAUNCH_GRACE_SECONDS=120
# A schedule with no mint-window end stops retrying this long after its start/opening time.
LAUNCH_MAX_WAIT_SECONDS=21600

# ───────── Launch engine (docs/adr/0005-launch-engine.md) ─────────
# Launch mints are pre-signed LAUNCH_ARM_SECONDS early and broadcast at T + LAUNCH_FIRE_OFFSET_MS from a
# millisecond timer (server clock: keep it NTP-synced). false = tick-only behaviour of v2.1.
LAUNCH_ENGINE=true
LAUNCH_ARM_SECONDS=60
# Negative fires before T (risk: a cheap revert, then an immediate re-sign). Tune from "Landed …" reports.
LAUNCH_FIRE_OFFSET_MS=50
# After T: timing failures and transient errors retry within milliseconds for this long, then the tick.
LAUNCH_HOT_WINDOW_SECONDS=120
LAUNCH_RETRY_INTERVAL_MS=250
LAUNCH_RECEIPT_POLL_MS=200
LAUNCH_RECEIPT_WATCH_SECONDS=60
# A mint that reverts on-chain (bad timing, gas cap too low) is re-signed with a fresh nonce this many times.
LAUNCH_MAX_CHAIN_RETRIES=3
LAUNCH_MAX_SESSIONS=100
# Pre-signed fee headroom over the base fee seen at arming time (30000 = ×3). Costs nothing extra under
# EIP-1559; raises only the balance the wallet must hold.
LAUNCH_ARMED_FEE_MULTIPLIER_BPS=30000
# Background loop (late schedules, funds waits, tracking). Launches do not depend on it.
WORKER_TICK_MS=5000

# ───────── Fees ─────────
# maxFeePerGas = baseFee × FEE_BASE_MULTIPLIER_BPS / 10000 + tip. Tip: 0 on first-come-first-served chains
# (Robinhood), the RPC's suggestion elsewhere; override per chain in gwei:
# e.g. PRIORITY_FEE_GWEI_JSON={"base":"0.05","ethereum":"2"}
PRIORITY_FEE_GWEI_JSON={}
FEE_BASE_MULTIPLIER_BPS=20000

# ───────── Gas policy ─────────
# gasLimit = estimate × GAS_ESTIMATE_MULTIPLIER_BPS / 10000, refused when the estimate exceeds
# GAS_CAP_BASE + GAS_CAP_PER_TOKEN × (quantity − 1). Calibrate from mainnet canary mints
# (execution_attempts.gas_used). Arbitrum One and Orbit chains (Robinhood) include parent-chain data cost
# in their estimates; override per chain:
# GAS_CAP_JSON={"arbitrum":{"base":800000,"perToken":120000},"robinhood":{"base":600000}}
GAS_CAP_BASE=300000
GAS_CAP_PER_TOKEN=100000
GAS_CAP_JSON={}
GAS_ESTIMATE_MULTIPLIER_BPS=12500

# ───────── Automatic signing ─────────
# MintPilot only signs automatically from encrypted custodial wallets. Defaults are OFF and dry-run;
# set these explicitly per deployment (they are not baked into the Docker image).
AUTOMATION_ENABLED=false
# true = run every check at mint time and report what would be sent, without signing.
AUTOMATION_DRY_RUN=true
# Chains where signing is on (default: every registry chain). Add a chain after its canary mint.
AUTOMATION_ALLOWED_CHAINS=ethereum,base,ink,robinhood,arbitrum,optimism,zora,shape,unichain,soneium
# Per-transaction automatic signing cap, independent of MAX_MINT_VALUE_ETH.
AUTOMATION_MAX_VALUE_ETH=0.2
AUTOMATION_MAX_CONCURRENT_WALLETS=4
AUTOMATION_WALLET_LOCK_TTL_SECONDS=120
# Exactly 64 hex characters (32 bytes). Back it up; changing it makes every encrypted wallet key unreadable.
AUTOMATION_MASTER_KEY=

# ───────── Scale ─────────
# Telegram updates handled in parallel (different chats); one chat is always handled in order.
BOT_MAX_CONCURRENT_UPDATES=32
# Per-user flood limit for commands/messages.
BOT_USER_MESSAGES_PER_WINDOW=20
BOT_USER_WINDOW_SECONDS=30
# Outbound pacing under Telegram's limits (~30 msg/s overall, ~1 msg/s per chat).
TELEGRAM_GLOBAL_PER_SECOND=25
TELEGRAM_PER_CHAT_INTERVAL_MS=1000
TELEGRAM_PER_CHAT_BURST=3
# Parallel receipt lookups per worker tick.
TRACKING_CONCURRENCY=8
# SIGTERM: stop taking work and wait this long for in-flight updates, ticks and launch sessions.
SHUTDOWN_DRAIN_SECONDS=20
